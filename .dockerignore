# Secrets — never bake into the image
.env

# Version control
.git/
.gitignore

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Generated output (mounted as a volume at runtime)
output/

# Test suite
tests/

# Docs & assets
docs/
*.md
*.mmd

# Build artifacts
# Note: website/studio/dist/ is intentionally NOT excluded here.
# The studio-builder stage in the Dockerfile runs `npm run build` inside Docker,
# so the local dist/ may not exist — and the .dockerignore must let the source
# through so Node can build it fresh. node_modules is excluded (large, rebuilt in-container).
website/studio/node_modules/
build/
*.egg-info/

# IDE / OS
.DS_Store
.vscode/
.idea/
*.swp
