        </mxCell>
        <mxCell id="p9c1" value="&lt;b style=&quot;font-size:14px&quot;&gt;1 · EXTERNAL SOURCES&lt;/b&gt;&lt;table width=&quot;905&quot; cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;font-size:11px;text-align:left&quot;&gt;&lt;tr&gt;&lt;td width=&quot;215&quot;&gt;NSE&lt;/td&gt;&lt;td width=&quot;610&quot;&gt;quotes · delivery · corp actions&lt;/td&gt;&lt;td width=&quot;80&quot;&gt;1, 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Shoonya&lt;/td&gt;&lt;td&gt;WebSocket LTP — primary tick source&lt;/td&gt;&lt;td&gt;1, 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AMC iNAV feeds&lt;/td&gt;&lt;td&gt;Nippon · Mirae · Motilal · Zerodha&lt;/td&gt;&lt;td&gt;1, 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AMFI / MFAPI.in&lt;/td&gt;&lt;td&gt;scheme NAV, fetched live&lt;/td&gt;&lt;td&gt;1, 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SEBI filings&lt;/td&gt;&lt;td&gt;14 AMCs · monthly .xlsx · Tier-1&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Sensibull / CFTC / IMF&lt;/td&gt;&lt;td&gt;FII-DII · COT · reserves · FX&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;GNews / NewsAPI&lt;/td&gt;&lt;td&gt;news · earnings · deals · insider&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Zerodha Kite MCP&lt;/td&gt;&lt;td&gt;live portfolio · holdings · orders&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LLM providers&lt;/td&gt;&lt;td&gt;Anthropic · OpenAI · local Ollama&lt;/td&gt;&lt;td&gt;1, 7&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="940" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p9c2" value="&lt;b style=&quot;font-size:14px&quot;&gt;2 · INGESTION&lt;/b&gt;&lt;table width=&quot;905&quot; cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; style=&quot;font-size:11px;text-align:left&quot;&gt;&lt;tr&gt;&lt;td width=&quot;215&quot;&gt;Fetcher adapters&lt;/td&gt;&lt;td width=&quot;610&quot;&gt;src/data_importer/fetchers/ — 30+&lt;/td&gt;&lt;td width=&quot;80&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fetcher registry&lt;/td&gt;&lt;td&gt;registry.py — 19 categories&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AMC importers&lt;/td&gt;&lt;td&gt;amc_downloaders/ · amc_holdings/&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Parallel importer&lt;/td&gt;&lt;td&gt;parallel_importer.py&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Source preference&lt;/td&gt;&lt;td&gt;source_preference.py&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Freshness audit&lt;/td&gt;&lt;td&gt;freshness.py · db/audit_freshness.py&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Repository runner&lt;/td&gt;&lt;td&gt;src/db/repository.py — run_fetcher()&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;EventBus&lt;/td&gt;&lt;td&gt;src/events/bus.py&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Observers (4)&lt;/td&gt;&lt;td&gt;src/events/observers.py&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
