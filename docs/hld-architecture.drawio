        <mxCell id="p8he4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="p8h4" target="p8h5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p8-deploy" name="9 · Deployment">
