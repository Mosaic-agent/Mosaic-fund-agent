        </mxCell>
        <mxCell id="p7qd" value="&lt;b&gt;Qdrant&lt;/b&gt;&lt;br&gt;semantic retrieval" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#3b0764;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="835" y="880" width="385" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p7cm" value="&lt;b&gt;Context Manager&lt;/b&gt;&lt;br&gt;&lt;i&gt;see tab 8&lt;/i&gt;&lt;br&gt;&lt;br&gt;compress() — truncate / summarise&lt;br&gt;→ DatasetRef + artifact key&lt;br&gt;&lt;br&gt;the agent gets a bounded view,&lt;br&gt;the full output stays on disk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p7ret" value="&lt;b&gt;Return path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Values travel back up &lt;b&gt;unchanged&lt;/b&gt;.&lt;br&gt;The agent quotes them verbatim&lt;br&gt;and cites the source table and&lt;br&gt;watermark timestamp." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p7guard" value="&lt;b style=&quot;font-size:15px&quot;&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;br&gt;●&amp;nbsp; No LLM arithmetic — ever&lt;br&gt;&lt;br&gt;●&amp;nbsp; Zero-trust: re-read raw tool output&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; before citing any number&lt;br&gt;&lt;br&gt;●&amp;nbsp; Symbol-row locking — the row must&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; match the symbol that was asked for&lt;br&gt;&lt;br&gt;●&amp;nbsp; Tool-loop protection&lt;br&gt;&lt;br&gt;●&amp;nbsp; Budget + tracing middleware&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; → agent_traces&lt;br&gt;&lt;br&gt;●&amp;nbsp; Unresolved security → explicit&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; [UNRESOLVED_SECURITY] marker,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; never an invented label" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;verticalAlign=top;spacingTop=10;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="590" width="340" height="410" as="geometry" />
        </mxCell>
