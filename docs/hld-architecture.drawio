  <diagram id="p6-ml" name="6 · ML &amp; Risk">
    <mxGraphModel dx="1800" dy="920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6t" value="6 · ML &amp;amp; Risk&lt;br&gt;&lt;font style=&quot;font-size:14px;font-weight:normal&quot;&gt;Forecast, anomaly detection, and how a position size is actually chosen&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6a" value="Trend Forecast  —  src/ml/trend_predictor.py" style="swimlane;html=1;startSize=36;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=16;fontStyle=1;fontColor=#7c2d12;align=center;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="820" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p6a1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;Features — OHLCV + DXY + US10Y&amp;nbsp;&amp;nbsp;&lt;i&gt;(fetched in parallel)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6a">
          <mxGeometry x="30" y="60" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6a2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;LightGBM walk-forward CV&amp;nbsp;&amp;nbsp;&lt;i&gt;(no look-ahead — train only on the past)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6a">
          <mxGeometry x="30" y="150" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6a3" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;Model cache — output/.cache/ml_models/ — cached .joblib models&lt;br&gt;&lt;i&gt;invalidated synchronously by the import observer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6a">
          <mxGeometry x="30" y="240" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6a4" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;5-day forecast&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;ml_predictions&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;drift_monitor watches decay" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6a">
          <mxGeometry x="30" y="330" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6b" value="Composite Anomaly Detector  —  src/ml/anomaly.py" style="swimlane;html=1;startSize=36;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=16;fontStyle=1;fontColor=#7c2d12;align=center;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="820" height="470" as="geometry" />
        </mxCell>
        <mxCell id="p6b1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;MAD-Z — robust z-score on returns" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="55" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6b2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;GARCH(1,1) — conditional volatility" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="123" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6b3" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;IsolationForest — multivariate outliers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="191" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6b4" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;PELT — structural change points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="259" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6b5" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Corporate-action guard&lt;/b&gt; — suppresses the is_anomaly flag on ex-dates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="327" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6b6" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;Volume HMM — accumulation / distribution state&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;market_anomalies&lt;/b&gt; (Qdrant)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fed7aa;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="p6b">
          <mxGeometry x="30" y="395" width="760" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p6r0" value="Position sizing chain" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6r1" value="&lt;b&gt;GARCH realised vol&lt;/b&gt;&lt;br&gt;target-vol scaling" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6r2" value="&lt;b&gt;Adaptive Kelly&lt;/b&gt;&lt;br&gt;fractional Kelly weight" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="390" y="640" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6r3" value="&lt;b&gt;Risk Governor&lt;/b&gt;&lt;br&gt;drawdown-aware weight (RG)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="720" y="640" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6r4" value="&lt;b&gt;weights.blended_50&lt;/b&gt;&lt;br&gt;50% RG + 50% Kelly&lt;br&gt;&lt;i&gt;◀ this is the recommendation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=3;fontColor=#7c2d12;" vertex="1" parent="1">
