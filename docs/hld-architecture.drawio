        <mxCell id="p8cm1" value="&lt;b&gt;run_scope()&lt;/b&gt;&amp;nbsp;&amp;nbsp;— opens a run-local cache + artifact ledger for one fan-out&lt;br&gt;&lt;b&gt;fetch_once(key, fetcher)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— identical fetches inside a run execute once" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;" vertex="1" parent="p8ccm">
          <mxGeometry x="25" y="45" width="790" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p8cm2" value="&lt;b&gt;compress(key, raw)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— truncate_text (cap &lt;b&gt;250,000 chars&lt;/b&gt;)&amp;nbsp;·&amp;nbsp;summarize_dict&amp;nbsp;·&amp;nbsp;dedup_rows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;" vertex="1" parent="p8ccm">
          <mxGeometry x="25" y="120" width="790" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p8cm3" value="&lt;b&gt;to_dataset_ref(key, raw)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;DatasetRef&lt;/b&gt;, appended to the run's artifact ledger&lt;br&gt;&lt;b&gt;artifacts()&lt;/b&gt;&amp;nbsp;&amp;nbsp;— every DatasetRef the run produced, in order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#164e63;" vertex="1" parent="p8ccm">
          <mxGeometry x="25" y="190" width="790" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p8cart" value="Artifact store  —  src/tools/mf_artifact.py" style="swimlane;html=1;startSize=34;fillColor=#faf5ff;strokeColor=#9333ea;fontSize=15;fontStyle=1;fontColor=#3b0764;align=center;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="840" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p8ar1" value="&lt;b&gt;write_mf_artifact(tool, params, full)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→ key &lt;b&gt;mf_artifact_&amp;lt;tool&amp;gt;_&amp;lt;digest&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;the complete output is persisted to disk, keyed by a hash of the call&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#3b0764;" vertex="1" parent="p8cart">
          <mxGeometry x="25" y="45" width="790" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p8ar2" value="&lt;b&gt;condense_text(...)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— small output passes through unchanged; large output becomes&lt;br&gt;head + tail + the artifact key the agent can call back for" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#3b0764;" vertex="1" parent="p8cart">
          <mxGeometry x="25" y="110" width="790" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p8ar3" value="&lt;b&gt;read_mf_artifact(key)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— retrieves the full output on demand — &lt;i&gt;nothing is ever lost, only deferred&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#3b0764;" vertex="1" parent="p8cart">
          <mxGeometry x="25" y="175" width="790" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p8cout" value="&lt;b&gt;Agent sees:&lt;/b&gt; a token-bounded excerpt + a retrieval key&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;&lt;i&gt;context stays small without discarding data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="840" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p8hl" value="&lt;b style=&quot;font-size:17px&quot;&gt;Agentic Harness — 5 layers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;applied top-down; a lower layer never overrides a higher one&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="105" width="780" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p8h1" value="&lt;b&gt;L1 · Global mandate&lt;/b&gt;&lt;br&gt;no LLM arithmetic · zero-trust re-read · verify dilution before&lt;br&gt;flagging a promoter sale · DSP cross-fund conviction signal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="175" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p8h2" value="&lt;b&gt;L2 · Context files&lt;/b&gt;&lt;br&gt;AGENTS.md (Codex) · GEMINI.md (Gemini CLI) · docs/CLAUDE.md&lt;br&gt;&lt;i&gt;kept content-identical — edit one, mirror the other&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="295" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p8h3" value="&lt;b&gt;L3 · Sub-agent definitions&lt;/b&gt;&lt;br&gt;.agents/agents/ — 23 definitions&lt;br&gt;&lt;i&gt;mosaic · stock-research · risk-governor · macro-strategy · live-monitor …&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="415" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p8h4" value="&lt;b&gt;L4 · Skills &amp;amp; commands&lt;/b&gt;&lt;br&gt;.agents/skills/ (24) · .claude/skills/ · .claude/commands/ (5) · .claude/workflows/&lt;br&gt;&lt;i&gt;goldbees-pipeline · ma-lens · intraday · risk-governor · commit …&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="535" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p8h5" value="&lt;b&gt;L5 · Caveman / cavecrew compression&lt;/b&gt;&lt;br&gt;.agents/skills/cavecrew · .claude/skills/&lt;br&gt;&lt;i&gt;sub-agent results come back compressed, so the main thread's context lasts longer&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="960" y="655" width="780" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p8hn" value="&lt;b&gt;Why two mechanisms&lt;/b&gt; — the &lt;b&gt;harness&lt;/b&gt; (right) decides what an agent is allowed to do before it runs;&lt;br&gt;the &lt;b&gt;ContextManager&lt;/b&gt; (left) decides how much of the result it is allowed to see afterwards." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#64748b;dashed=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="960" y="790" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p8ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#0891b2;" edge="1" parent="1" source="p8craw" target="p8ccm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8ce2" value="persist full output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=12;" edge="1" parent="1" source="p8ccm" target="p8cart"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="p8cart" target="p8cout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8he1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="p8h1" target="p8h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8he2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="p8h2" target="p8h3"><mxGeometry relative="1" as="geometry" /></mxCell>
