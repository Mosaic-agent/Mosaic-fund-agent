        <mxCell id="p8ccm" value="ContextManager  —  src/workflows/context_manager.py" style="swimlane;html=1;startSize=34;fillColor=#ecfeff;strokeColor=#0891b2;fontSize=15;fontStyle=1;fontColor=#164e63;align=center;rounded=1;arcSize=2;" vertex="1" parent="1">
