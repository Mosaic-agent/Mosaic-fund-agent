        <mxCell id="1" parent="0" />
        <mxCell id="p5t" value="5 · Signal Pipeline&lt;br&gt;&lt;font style=&quot;font-size:14px;font-weight:normal&quot;&gt;Six independent pillars → one composite score&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p5p1" value="&lt;b&gt;Macro&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;25%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— GNews theme scan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="130" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5p2" value="&lt;b&gt;Flow&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;25%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— fii_dii_flows, 5-day net" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="240" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5p3" value="&lt;b&gt;Sentiment&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;15%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— news_articles + Qdrant RAG" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="350" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5p4" value="&lt;b&gt;Valuation&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;15%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— live iNAV Z-score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5p5" value="&lt;b&gt;ML&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;15%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— ml_predictions (5-day LightGBM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="570" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5p6" value="&lt;b&gt;GARCH anomaly&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#9a3412&quot;&gt;&lt;b&gt;5%&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;— composite anomaly score" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="90" y="680" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p5agg" value="&lt;b style=&quot;font-size:16px&quot;&gt;SignalAggregator&lt;/b&gt;&lt;br&gt;src/agents/signal_aggregator.py&lt;br&gt;&lt;br&gt;all 6 sources run in parallel&lt;br&gt;(ThreadPoolExecutor)&lt;br&gt;&lt;br&gt;graceful pillar degradation —&lt;br&gt;a dead source drops out,&lt;br&gt;it never fabricates a score&lt;br&gt;&lt;br&gt;&lt;i&gt;79 s → 9 s after parallelisation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=3;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p5rule" value="&lt;b&gt;Hard rule&lt;/b&gt; — every pillar score is computed in Python / SQL.&lt;br&gt;The LLM reads the result and narrates it; it never does the arithmetic,&lt;br&gt;and never invents a label such as “ACCUMULATE” on top of regime_signal." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#ea580c;dashed=1;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="960" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5comp" value="&lt;b style=&quot;font-size:16px&quot;&gt;Composite score 0–100&lt;/b&gt;&lt;br&gt;→ BUY / HOLD / SELL&lt;br&gt;&lt;i&gt;regime_signal is used exactly as returned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="330" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5tab" value="&lt;b&gt;signal_composite&lt;/b&gt;&lt;br&gt;ClickHouse · written by: signals --save" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#3b0764;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="500" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5cons" value="&lt;b&gt;Consumers&lt;/b&gt;&lt;br&gt;CLI: signals · Streamlit Signals tab&lt;br&gt;Signal sub-agent · GOLDBEES pipeline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="670" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p1" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p2" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p3" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p4" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p5" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5p6" target="p5agg"><mxGeometry relative="1" as="geometry" /></mxCell>
