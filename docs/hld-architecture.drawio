        <mxCell id="p8s5" value="&lt;b&gt;ui&lt;/b&gt;&lt;br&gt;Streamlit :8501" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="p8host">
          <mxGeometry x="40" y="205" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8s6" value="&lt;b&gt;live-monitor&lt;/b&gt;&lt;br&gt;compose profile — opt-in&lt;br&gt;Shoonya WS → Slack alerts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="p8host">
