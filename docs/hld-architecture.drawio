          <mxGeometry x="610" y="390" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p7d3" value="&lt;b&gt;Declarative Playbooks&lt;/b&gt;&amp;nbsp;(10)&lt;br&gt;config/agents/*.yaml&lt;br&gt;&lt;br&gt;configuration-driven specs&lt;br&gt;executed by declarative_runner.py" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="1040" y="390" width="400" height="140" as="geometry" />
