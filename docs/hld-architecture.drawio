        <mxCell id="p8t" value="9 · Deployment&lt;br&gt;&lt;font style=&quot;font-size:14px;font-weight:normal&quot;&gt;Everything runs in Docker Compose — the app container stays up&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="1480" height="55" as="geometry" />
