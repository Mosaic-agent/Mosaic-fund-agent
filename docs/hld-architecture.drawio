        <mxCell id="p8s8" value="&lt;b&gt;files&lt;/b&gt;&lt;br&gt;report server :8502" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;" vertex="1" parent="p8host">
          <mxGeometry x="1120" y="205" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8vol" value="&lt;b&gt;Named volumes&lt;/b&gt; — clickhouse-data · clickhouse-backups · qdrant-data · ollama-models&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Bind mounts&lt;/b&gt; — ./src · ./config · ./tests · ./output&lt;br&gt;&lt;i&gt;bind mounts mean edited source and generated reports are visible on the host instantly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#ef4444;dashed=1;fontColor=#7f1d1d;" vertex="1" parent="p8host">
          <mxGeometry x="40" y="355" width="1410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p8exec" value="&lt;b style=&quot;font-size:15px&quot;&gt;Execution path&lt;/b&gt;&lt;br&gt;&lt;br&gt;./mosaic.sh &amp;lt;cmd&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&amp;nbsp;docker compose exec -T mosaic python src/main.py &amp;lt;cmd&amp;gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Never a transient one-off container, never host-local python / uv — exec into the running service for sub-second startup.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="p8host">
          <mxGeometry x="40" y="485" width="1410" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p8note" value="&lt;b&gt;Startup&lt;/b&gt;&amp;nbsp;&amp;nbsp;docker compose up -d mosaic&amp;nbsp;&amp;nbsp;(brings up clickhouse + qdrant via depends_on / healthcheck)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;profiles keep live-monitor and etf-scanner off by default&lt;br&gt;&lt;b&gt;Secrets&lt;/b&gt;&amp;nbsp;&amp;nbsp;.env stays on the host and is loaded with env_file — it is never copied into the image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="1480" height="90" as="geometry" />
        </mxCell>
      </root>
