  <diagram id="p7-agents" name="7 · Agent Flow">
    <mxGraphModel dx="1700" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p7t" value="7 · Agent Request Flow&lt;br&gt;&lt;font style=&quot;font-size:14px;font-weight:normal&quot;&gt;What happens between a question and an answer&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="1500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p7user" value="👤&amp;nbsp;&amp;nbsp;&lt;b&gt;mosaic ask&lt;/b&gt; “what is my GOLDBEES signal?”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p7router" value="&lt;b style=&quot;font-size:16px&quot;&gt;Intent Router&lt;/b&gt;&amp;nbsp;&amp;nbsp;src/agents/intent_router.py&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; LLM classifier&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;2&lt;/b&gt; RAG semantic match&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;&lt;b&gt;3&lt;/b&gt; regex fallback" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#bfdbfe;strokeColor=#3b82f6;strokeWidth=2;fontColor=#1e3a5f;" vertex="1" parent="1">
