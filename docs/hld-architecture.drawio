        </mxCell>
        <mxCell id="p6r5" value="&lt;b&gt;VLRT v3&lt;/b&gt;&lt;br&gt;dynamic allocation across sleeves" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="1380" y="640" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6note" value="&lt;b&gt;Rule&lt;/b&gt; — the recommended GOLDBEES position weight is always &lt;b&gt;weights.blended_50&lt;/b&gt;, never weights.rg on its own." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#ea580c;dashed=1;fontColor=#7c2d12;" vertex="1" parent="1">
