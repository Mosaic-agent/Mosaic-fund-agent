  <diagram id="p5-signal" name="5 · Signal Pipeline">
    <mxGraphModel dx="1700" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="880" math="0" shadow="0">
      <root>
