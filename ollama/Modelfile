FROM gemma4:12b-mlx

# ── Context window ──────────────────────────────────────────────────────────
# 16 384 is sufficient for a full Mosaic ReAct loop (tool schemas + history).
# Halving from 32 768 cuts KV-cache memory ~50% and speeds prefill on M-series.
# Must match LLM_CONTEXT_WINDOW in .env.
PARAMETER num_ctx 16384

# ── Sampling ────────────────────────────────────────────────────────────────
# Temperature 0 = deterministic / greedy — required for reliable tool-call JSON.
PARAMETER temperature 0

# ── Generation limit ─────────────────────────────────────────────────────────
# ReAct tool responses are short; cap generation to avoid wasted compute.
PARAMETER num_predict 1024

# ── Batch size ───────────────────────────────────────────────────────────────
# 4096 is safe for gemma4:12b-mlx (~7-8 GB) on M-series with 36 GB unified memory;
# doubles prefill throughput vs 2048 with headroom to spare.
PARAMETER num_batch 4096

# ── System persona ──────────────────────────────────────────────────────────
# Lightweight baseline; each sub-agent/main-agent overrides with its own
# domain-specific system prompt at runtime.
SYSTEM """
You are Mosaic, a quantitative analyst assistant for Indian equity and commodity markets.
You respond with precise, data-driven analysis.  Never invent numbers — only narrate
outputs that come from tool calls or pre-computed code results.
"""
